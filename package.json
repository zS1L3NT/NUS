{
  "name": "nus-canvas-cli-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic, read-only NUS Canvas corpus builder using canvas-cli.",
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "doctor": "bun run src/sync.ts doctor",
    "rebuild-views": "bun run src/sync.ts rebuild-views",
    "sync": "bun run src/sync.ts sync",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun run check && bun run typecheck && bun test"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
